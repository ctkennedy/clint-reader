{
  "name": "clint-reader",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:studio": "npm run db:studio -w server"
  },
  "dependencies": {
    "@netlify/database": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "netlify-cli": "^27.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true,
    "netlify-cli@27.1.1": true,
    "sharp@0.34.5": true,
    "unix-dgram@2.0.7": true,
    "esbuild@0.28.1": true
  }
}
